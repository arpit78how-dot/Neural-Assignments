import pandas as pd
data = {
 "Name": ["A", "B", "C", "D", "E"],
 "Age": [20, 25, 22, 30, 28],
 "Marks": [85, 72, 90, 65, 88],
 "City": ["Delhi", "Mumbai", "Delhi", "Pune", "Mumbai"]
}
df = pd.DataFrame(data)

#(1)Print first 3 rows
print("(1)First 3 rows :\n", df.head(3))
#(2)Print last2 rows
print("\n(2)Last 2 rows :\n", df.tail(2))
#(3)Print shape
print("\n(3) Shape of dataframe\n ", df.shape)
#(4)Print column names
print("\n(4) Column names:", df.columns)
#(5)Print data types
print("\n(5) Data type : \n", df.dtypes)
#(6)Select only name and marks
print("\n(6) Names and Marks :\n", df[["Name", "Marks"]])
#(7)Select studnets whose marks >80
print("\n(7) Students whose marks >80 :", df[df["Marks"] > 80])
#(8)Sort studnets by makrs from highest to lowest
print("\n(8)Sort students:\n", df.sort_values(by="Marks", ascending=False))
